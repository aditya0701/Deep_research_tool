DEEPSEEK_API_KEY=your-key-here
RESEARCH_AGENT_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING=true
RESEARCH_AGENT_MAX_TOKENS=8000

# Shared secret required in the X-API-Key header of POST /api/concise (deep_research/api.py).
# Set this as a Space secret, and as the same-named GitHub Actions secret for any workflow
# that calls the endpoint. Without it, /api/concise refuses every request (fails closed).
CONCISE_API_KEY=your-shared-secret-here
